# ============================================
# Environment Configuration — Example
# ============================================
# Copy this file to .env and fill in your actual values.
# Never commit .env with real secrets to version control.

# Application Settings
ENVIRONMENT=development
NODE_ENV=development
VERCEL_ENV=preview
APP_NAME=Wedding WebApp API
APP_VERSION=1.3.0
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here
CRON_SECRET=your-cron-secret-here
ROOT_ADMIN_PASSWORD=your-root-admin-password
ROOT_ADMIN_EMAIL=admin@yourdomain.com

# Test Account Fixtures (manual-flow testing only)
# These values are NOT auto-seeded by startup scripts.
# Create these accounts manually through the frontend when testing:
# - planner signup
# - planner checkout / subscription flows
# - vendor signup
# - couple invite/setup
# - team member invite/accept
TEST_PLANNER_EMAIL=test.verification@example.com
TEST_PLANNER_PASSWORD=testPass123!

# mongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGO_NAME=wedding
MONGO_ROOT_PASSWORD=your-mongo-root-password
MONGO_DB=wedding

# ============================================
# Cloudflare R2 Storage — Wedding Gallery
# ============================================
# Stores wedding photos, guest uploads, our-story images, etc.
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=wedding-gallery
MEDIA_DOMAIN=media.yourdomain.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_REGION=auto

# ============================================
# Cloudflare R2 Storage — Vendor Ad Assets
# ============================================
# Separate bucket for vendor advertising images and creative.
# Isolated from wedding content for independent access control,
# cost tracking, lifecycle rules, and future billing metering.
# Uses the same R2 credentials (same Cloudflare account).
S3_AD_BUCKET_NAME=vendor-ad-assets
AD_MEDIA_DOMAIN=ad-media.yourdomain.com

# ============================================
# Cloudflare R2 Storage — Blog Assets
# ============================================
# Shared bucket for blog card images, OG images, and KB assets.
# Uses the same R2 credentials (same Cloudflare account).
S3_BLOG_BUCKET_NAME=blog-assets
BLOG_MEDIA_DOMAIN=blog-media.yourdomain.com

# ============================================
# Cloudflare R2 Storage + Stream — Guest Memories
# ============================================
# Dedicated bucket for guest-uploaded photos/videos.
# Videos stay here as originals and are copied into Cloudflare Stream
# for smoother couple-portal playback.
S3_GUEST_MEDIA_BUCKET_NAME=guest-memories
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-api-token-with-stream-access

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Host header validation
# Optional explicit override. When unset, the app derives trusted hosts from
# FRONTEND_URL, NEXT_PUBLIC_API_BASE_URL, and CORS_ORIGINS.
# ALLOWED_HOSTS=localhost,127.0.0.1,app.yourdomain.com,api.yourdomain.com

# Rate Limiting (higher limits for development)
RATE_LIMIT_CALLS=500
RATE_LIMIT_PERIOD=60
RATE_LIMIT_AUTH_CALLS=20
RATE_LIMIT_AUTH_PERIOD=60
RATE_LIMIT_WINDOW=900
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PER_MINUTE=60

# Platform Metrics Configuration
DEFAULT_UPTIME_PERCENTAGE=99.9
SLOW_REQUEST_THRESHOLD_SECONDS=1.0
ERROR_RATE_DOWN_THRESHOLD=50

# Interactive FastAPI docs/schema
# Defaults to enabled outside production and disabled in production when unset.
# Uncomment only if you need to override the environment-based default.
# ENABLE_API_DOCS=true

# Security/audit file logging
# Defaults are repo-local writable paths for local and staging environments.
# SECURITY_LOG_TO_FILE=true
# SECURITY_LOG_FILE=logs/security_audit.log
# AUDIT_LOG_FILE=logs/audit.log

# Guest invite/session hardening
# Short-lived HttpOnly cookie used after exchanging guest invite links.
# GUEST_ACCESS_SESSION_MINUTES=180

# Telnyx
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_PUBLIC_KEY=your-telnyx-public-key
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TEST_RECIPIENT=+1XXXXXXXXXX
TELNYX_PROFILE_ID=your-telnyx-profile-id
TELNYX_TEST_WEBHOOK_URL=https://webhook.site/your-webhook-id

# SMS Provider
SMS_PROVIDER=Twilio
SMS_THROTTLE_DELAY_MS=200

# Email Configuration (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_BILLING_EMAIL=billing@yourdomain.com
RESEND_FROM_NAME=YourPlatform
RESEND_TO_EMAIL=support@yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# Redis Configuration (for Celery task queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true
CACHE_ENABLED=true
CACHE_TTL=300

CI=false

# Stripe Configuration
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Slack Webhook
SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/url

# Twilio credentials for sending SMS notifications
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_ENABLED=true
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid

# Local development API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local Dev Frontend URL for email verification links and testing
FRONTEND_URL=http://localhost:3000

# Production API URL
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Production Frontend URL
# FRONTEND_URL=https://yourdomain.com

# Google Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/planner/calendar/callback

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key

GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_ANALYTICS_ID=your-google-analytics-id

# Ntfy Push Notifications
SERVICE_URL_NTFY=notify.yourdomain.com
NTFY_ADMIN_TOPIC=wedding-platform-admin

# ============================================
# STRIPE TEST CARDS (For Development/Testing)
# ============================================
# Use these card numbers with:
#   - Expiry: Any future date (e.g., 12/34)
#   - CVC: Any 3 digits (e.g., 123), 4 digits for Amex
#   - ZIP: Any 5 digits (e.g., 12345)
#   - Name: The test planner's name
#   - Email: The test planner's email

# --- SUCCESSFUL PAYMENT CARDS ---
STRIPE_TEST_CARD_VISA=4242424242424242
STRIPE_TEST_CARD_MASTERCARD=5555555555554444
STRIPE_TEST_CARD_AMEX=378282246310005
STRIPE_TEST_CARD_DISCOVER=6011111111111117

# --- DECLINED/FAILED PAYMENT CARDS ---
STRIPE_TEST_CARD_DECLINED=4000000000000002
STRIPE_TEST_CARD_INSUFFICIENT_FUNDS=4000000000009995
STRIPE_TEST_CARD_LOST=4000000000009987
STRIPE_TEST_CARD_STOLEN=4000000000009979
STRIPE_TEST_CARD_EXPIRED=4000000000000069
STRIPE_TEST_CARD_INCORRECT_CVC=4000000000000127
STRIPE_TEST_CARD_PROCESSING_ERROR=4000000000000119

# --- 3D SECURE / AUTHENTICATION CARDS ---
STRIPE_TEST_CARD_3DS_REQUIRED=4000002500003155
STRIPE_TEST_CARD_3DS_ALWAYS=4000002760003184
STRIPE_TEST_CARD_3DS_OPTIONAL=4000000000003220

# --- SPECIFIC ERROR TESTING ---
STRIPE_TEST_CARD_FRAUD_ALWAYS=4100000000000019
STRIPE_TEST_CARD_CHARGE_FAIL=4000000000000341

# --- DEFAULT TEST CREDENTIALS ---
STRIPE_TEST_EXPIRY=12/34
STRIPE_TEST_CVC=123
STRIPE_TEST_CVC_AMEX=1234
STRIPE_TEST_ZIP=12345
STRIPE_TEST_NAME=Test User

# Alert Email
ALERT_EMAIL=alerts@yourdomain.com

# Soketi (WebSocket server)
SOKETI_ENABLED=true
SOKETI_HOST=soketi.yourdomain.com
SOKETI_PORT=6001
SOKETI_APP_ID=your-app-id
SOKETI_KEY=your-app-key
SOKETI_SECRET=your-app-secret
SOKETI_USE_TLS=true

# Frontend Soketi (add to .env.local)
NEXT_PUBLIC_SOKETI_KEY=your-app-key
NEXT_PUBLIC_SOKETI_HOST=soketi.yourdomain.com
NEXT_PUBLIC_SOKETI_PORT=6001
NEXT_PUBLIC_SOKETI_USE_TLS=true

# VAPID Keys (Web Push Notifications)
VAPID_MAIL="mailto:admin@yourdomain.com"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# DigitalOcean
DIGITALOCEAN_ACCESS_TOKEN="your-digitalocean-access-token"
DOKS_CLUSTER_NAME="your-cluster-name"
