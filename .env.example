# Copy this file to .env and update the values

# Python path
PYTHONPATH=/workspaces/WeddingWebApp

# JWT Secret Key - Generate a secure random key for production
SECRET_KEY=your-secret-key-here

# Primary Admin Configuration
PRIMARY_ADMIN_EMAIL=admin@example.com
PRIMARY_ADMIN_PASSWORD=change-me-in-production
PRIMARY_ADMIN_ROLE=admin

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wedding
MONGO_NAME=wedding

# API Configuration (if needed)
API_KEY=your-api-key-here

# Twilio credentials for sending SMS notifications 
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=your_phone_number

# Cloudflare R2 Storage Configuration
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET_NAME=wedding-gallery
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key

# Gallery Configuration
NEXT_PUBLIC_API_BASE_URL=https://thespecialwedding.com/api

# Google Maps API Key for venue map display (server-side only)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Maps Embed API
# This is kept server-side for security - do NOT prefix with NEXT_PUBLIC_
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CORS Configuration for development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Test Configuration (for Playwright tests)
TEST_BASE_URL=http://localhost:3004
TEST_API_URL=http://localhost:8000
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=test123

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@example.com

# SMS Provider Selection (twilio or telnyx)
SMS_PROVIDER=twilio

# Telnyx Configuration (alternative to Twilio)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PUBLIC_KEY=your_telnyx_public_key
TELNYX_PHONE_NUMBER=your_telnyx_phone
TELNYX_PROFILE_ID=your_telnyx_profile_id
TELNYX_TEST_WEBHOOK_URL=your_webhook_url

# Root Admin Configuration
ROOT_ADMIN_EMAIL=admin@example.com
