# Wedding Web App Environment Configuration
# Copy this file to .env and update with your actual values

# ================================
# APPLICATION SETTINGS
# ================================
NODE_ENV=development
PORT=3005
API_PORT=8000
PYTHONPATH=/workspaces/WeddingWebApp

# ================================
# DATABASE CONFIGURATION
# ================================
# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wedding
MONGO_NAME=wedding
MONGODB_URL=mongodb://localhost:27017/wedding_app

# ================================
# SECURITY CONFIGURATION
# ================================
# JWT Secret Key - Generate a secure random key for production
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# API Configuration
API_KEY=your-api-key-here

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Security Features
ENABLE_CSRF_PROTECTION=true
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900  # 15 minutes in seconds

# ================================
# ADMIN CONFIGURATION
# ================================
# Primary Admin Configuration
PRIMARY_ADMIN_EMAIL=admin@example.com
PRIMARY_ADMIN_PASSWORD=change-me-in-production
PRIMARY_ADMIN_ROLE=admin
ROOT_ADMIN_EMAIL=admin@example.com

# ================================
# SMS CONFIGURATION
# ================================
# SMS Provider Selection (twilio or telnyx)
SMS_PROVIDER=twilio

# Twilio credentials for sending SMS notifications 
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=your_phone_number

# Telnyx Configuration (alternative to Twilio)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PUBLIC_KEY=your_telnyx_public_key
TELNYX_PHONE_NUMBER=your_telnyx_phone
TELNYX_PROFILE_ID=your_telnyx_profile_id
TELNYX_TEST_WEBHOOK_URL=your_webhook_url

# ================================
# EMAIL CONFIGURATION
# ================================
# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@example.com
FROM_EMAIL=noreply@special-wedding.com

# ================================
# FILE STORAGE CONFIGURATION
# ================================
# Cloudflare R2 Storage Configuration
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET_NAME=wedding-gallery
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key

# AWS S3 Configuration (alternative)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf

# ================================
# GALLERY CONFIGURATION
# ================================
# Gallery Configuration
NEXT_PUBLIC_API_BASE_URL=https://thespecialwedding.com/api

# ================================
# MAPS CONFIGURATION
# ================================
# Google Maps API Key for venue map display (server-side only)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Maps Embed API
# This is kept server-side for security - do NOT prefix with NEXT_PUBLIC_
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ================================
# TESTING CONFIGURATION
# ================================
# Test Configuration (for Playwright tests)
TEST_BASE_URL=http://localhost:3004
TEST_API_URL=http://localhost:8000
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=test123

# Development/Testing flags
BYPASS_AUTH=false
MOCK_SMS_PROVIDER=false
MOCK_EMAIL_PROVIDER=false

# ================================
# SAAS CONFIGURATION
# ================================
# SaaS Features
ENABLE_SAAS_FEATURES=true
DEFAULT_TRIAL_DAYS=14

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ================================
# CACHING CONFIGURATION
# ================================
# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# ================================
# MONITORING & ANALYTICS
# ================================
# Monitoring and Logging
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_here

# Analytics
# Cloudflare Web Analytics (FREE, unlimited pageviews)
# Get token from: Cloudflare Dashboard → Analytics → Web Analytics → Add a site
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your_cloudflare_token_here

# Vercel Analytics (FREE, already integrated in layout.tsx)
VERCEL_ANALYTICS_ENABLED=true

# ================================
# BACKUP CONFIGURATION
# ================================
# Backup secret for Cloudflare Workers authentication
# Generate with: openssl rand -hex 32
BACKUP_SECRET=your-backup-secret-key-here

# ================================
# FEATURE FLAGS
# ================================
# Feature Flags
ENABLE_ADMIN_PANEL=true
ENABLE_SMS_REMINDERS=true
ENABLE_EMAIL_REMINDERS=true
ENABLE_GALLERY_UPLOAD=true
