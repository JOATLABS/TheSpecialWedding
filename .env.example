# ============================================
# Environment Configuration — Example
# ============================================
# Copy this file to .env and fill in your actual values.
# Never commit .env with real secrets to version control.

# Application Settings
ENVIRONMENT=development
NODE_ENV=development
VERCEL_ENV=preview
APP_NAME=Wedding WebApp API
APP_VERSION=1.3.0
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here
CRON_SECRET=your-cron-secret-here
ROOT_ADMIN_PASSWORD=your-root-admin-password
ROOT_ADMIN_EMAIL=admin@yourdomain.com

# ElevenLabs narration generation (marketing demo videos; scripts/demo-videos/generate-narration.ts)
# The GitHub Actions secret uses the ELEVEN_LABS_API_KEY spelling; both are accepted.
ELEVEN_LABS_API_KEY=your-elevenlabs-api-key
# Optional overrides — defaults live in scripts/demo-videos/generate-narration.ts.
# The default voice is the founder's ElevenLabs clone; set ELEVENLABS_VOICE_ID
# to narrate with a different voice (premade US-female fallback: 21m00Tcm4TlvDq8ikWAM).
#ELEVENLABS_VOICE_ID=
#ELEVENLABS_MODEL_ID=eleven_multilingual_v2
#ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
#ELEVENLABS_SPEED=

# Test Account Fixtures (manual-flow testing only)
# These values are NOT auto-seeded by startup scripts.
# Create these accounts manually through the frontend when testing:
# - planner signup
# - planner checkout / subscription flows
# - vendor signup
# - couple invite/setup
# - team member invite/accept
TEST_PLANNER_EMAIL=test.verification@example.com
TEST_PLANNER_PASSWORD=testPass123!

# mongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGO_NAME=wedding
MONGO_ROOT_PASSWORD=your-mongo-root-password
MONGO_DB=wedding

# ============================================
# Cloudflare R2 Storage — Wedding Gallery
# ============================================
# Stores wedding photos, guest uploads, our-story images, etc.
# Account ID must match CLOUDFLARE_ACCOUNT_ID exactly (32 hex characters).
S3_ENDPOINT_URL=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
S3_BUCKET_NAME=wedding-gallery
MEDIA_DOMAIN=media.yourdomain.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_REGION=auto

# ============================================
# Cloudflare R2 Storage — Vendor Ad Assets
# ============================================
# Separate bucket for vendor advertising images and creative.
# Isolated from wedding content for independent access control,
# cost tracking, lifecycle rules, and future billing metering.
# Uses the same R2 credentials (same Cloudflare account).
S3_AD_BUCKET_NAME=vendor-ad-assets
AD_MEDIA_DOMAIN=ad-media.yourdomain.com

# ============================================
# Cloudflare R2 Storage — Blog Assets
# ============================================
# Shared public bucket for blog/KB assets and sanitized storefront images.
# Approved v1 intentionally reuses this existing public bucket; only the
# private staging bucket below is a new planner-storefront bucket. Storefront
# objects remain isolated beneath the storefront/ prefix.
# Uses the same bucket-scoped R2 credentials (same Cloudflare account).
S3_BLOG_BUCKET_NAME=knowledgeable-saas-blogs
BLOG_MEDIA_DOMAIN=blogs.thespecialwedding.io

# Private browser-upload staging for planner storefront images. Do not attach
# an r2.dev URL or public/custom domain to this bucket.
S3_STOREFRONT_STAGING_BUCKET_NAME=the-special-wedding-storefront-staging
# Required enabled R2 lifecycle delete rule for prefix storefront/ (days).
STOREFRONT_STAGING_LIFECYCLE_MAX_AGE_DAYS=1
# Bound memory-heavy Pillow decode/re-encode work per API process.
STOREFRONT_IMAGE_DECODE_CONCURRENCY=1

# ============================================
# BabyLoveGrowth Blog Integration
# ============================================
# API pull powers manual/admin backfill. Webhook powers BLG dashboard Publish.
BABYLOVEGROWTH_API_KEY=your-babylovegrowth-api-key
BABYLOVEGROWTH_API_BASE_URL=https://api.babylovegrowth.ai/api/integrations
BABYLOVEGROWTH_SYNC_ENABLED=false
BABYLOVEGROWTH_WEBHOOK_SECRET=your-babylovegrowth-webhook-bearer-token
BABYLOVEGROWTH_LAND_AS_DRAFT=true

# ============================================
# Cloudflare R2 Storage + Stream — Guest Memories
# ============================================
# Dedicated bucket for guest-uploaded photos/videos.
# Videos stay here as originals and are copied into Cloudflare Stream
# for smoother couple-portal playback.
S3_GUEST_MEDIA_BUCKET_NAME=guest-memories
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# Existing Cloudflare control-plane token for R2/Stream safety checks only.
# It must not have or substitute for Cloudflare for SaaS custom-host permissions.
CLOUDFLARE_API_TOKEN=your-scoped-cloudflare-token-for-r2-control-read
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-api-token-with-stream-access

# Cloudflare for SaaS custom hostnames. Use a dedicated least-privilege token
# with Zone Read and SSL and Certificates Write for only the SaaS zone; never
# reuse the R2/Stream control-plane token above. Automatic DNS remains
# independently disabled until the template is externally onboarded.
# Setup and verification: docs/guides/STOREFRONT_INFRASTRUCTURE_SETUP.md
STOREFRONT_CUSTOM_DOMAINS_ENABLED=false
STOREFRONT_DOMAIN_CONNECT_DISCOVERY_ENABLED=false
STOREFRONT_DOMAIN_CONNECT_AUTHORIZATION_ENABLED=false
STOREFRONT_CLOUDFLARE_MUTATIONS_ENABLED=false
# Keep cleanup independently enabled once any provider hostname exists so a
# rollback can stop onboarding without stranding disconnect retries.
STOREFRONT_CLOUDFLARE_CLEANUP_ENABLED=false
STOREFRONT_CUSTOM_DOMAIN_ROLLOUT_MODE=allowlist
STOREFRONT_CUSTOM_DOMAIN_PILOT_HOSTNAMES=[]
STOREFRONT_CUSTOM_DOMAIN_PILOT_OWNER_IDS=[]
CLOUDFLARE_SAAS_API_TOKEN=
# Optional operator-only token for the same-zone infrastructure canary. Scope
# it to DNS Read + DNS Edit on thespecialwedding.com only. Never reuse the SaaS
# token and never expose this token to the application runtime or customer flow.
CLOUDFLARE_PLATFORM_DNS_API_TOKEN=
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
STOREFRONT_FALLBACK_ORIGIN=storefront-origin.thespecialwedding.com
STOREFRONT_CNAME_TARGET=domains.thespecialwedding.com
STOREFRONT_PLATFORM_DOMAINS=["thespecialwedding.io","thespecialwedding.com"]
# Server-only shared credential used by the Next custom-host edge to authenticate
# probe requests to FastAPI. Generate at least 32 random bytes and configure the
# same secret in both runtimes; never prefix it with NEXT_PUBLIC_.
STOREFRONT_PROBE_INGRESS_SECRET=
DOMAIN_CONNECT_PROVIDER_ID=thespecialwedding.com
DOMAIN_CONNECT_SERVICE_ID=storefront-subdomain
DOMAIN_CONNECT_TEMPLATE_VERSION=1
DOMAIN_CONNECT_PRIVATE_KEY=
DOMAIN_CONNECT_KEY_ID=_dcpubkeyv1
DOMAIN_CONNECT_PUBLIC_KEY_DOMAIN=domainconnect.thespecialwedding.com
DOMAIN_CONNECT_CALLBACK_URL=https://domainconnect.thespecialwedding.com/admin/storefront/custom-domain/domain-connect/callback
# Non-secret deploy/build identity. The storefront testbed requires this to
# match its current checkout + tracked diff fingerprint.
STOREFRONT_RUNTIME_REVISION=replace-with-deployment-revision

# ============================================
# Cloudflare R2 Storage — Public Form Uploads
# ============================================
# Dedicated bucket for token-gated public form attachments.
# Configure this bucket/CDN to serve attachments, not inline active content.
S3_FORM_UPLOADS_BUCKET_NAME=form-uploads
FORM_UPLOADS_DOMAIN=form-uploads.yourdomain.com

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Host header validation
# Optional explicit override. When unset, the app derives trusted hosts from
# FRONTEND_URL, NEXT_PUBLIC_API_BASE_URL, and CORS_ORIGINS.
# ALLOWED_HOSTS=localhost,127.0.0.1,app.yourdomain.com,api.yourdomain.com

# Trust forwarded client IPs only when the direct peer is in one of these
# explicit networks and the ingress overwrites the configured single-value
# header. Leave both unset to use the direct peer address.
TRUSTED_PROXY_CIDRS=[]
# The production Compose ingress overwrites X-Real-IP and defaults its trusted
# peer network to 172.26.0.0/16. Use CF-Connecting-IP only when a trusted ingress
# validates the Cloudflare source and overwrites that header before FastAPI.
# TRUSTED_PROXY_CLIENT_IP_HEADER=X-Real-IP

# Rate Limiting (higher limits for development)
RATE_LIMIT_CALLS=500
RATE_LIMIT_PERIOD=60
RATE_LIMIT_AUTH_CALLS=20
RATE_LIMIT_AUTH_PERIOD=60
RATE_LIMIT_LOGIN_IP_CALLS=30
RATE_LIMIT_LOGIN_PRINCIPAL_CALLS=5
RATE_LIMIT_LOGIN_PERIOD=60
RATE_LIMIT_WINDOW=900
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PER_MINUTE=60

# Platform Metrics Configuration
DEFAULT_UPTIME_PERCENTAGE=99.9
SLOW_REQUEST_THRESHOLD_SECONDS=1.0
ERROR_RATE_DOWN_THRESHOLD=50

# Interactive FastAPI docs/schema
# Defaults to enabled outside production and disabled in production when unset.
# Uncomment only if you need to override the environment-based default.
# ENABLE_API_DOCS=true

# Security/audit file logging
# Defaults are repo-local writable paths for local and staging environments.
# SECURITY_LOG_TO_FILE=true
# SECURITY_LOG_FILE=logs/security_audit.log
# AUDIT_LOG_FILE=logs/audit.log

# Guest invite/session hardening
# Short-lived HttpOnly cookie used after exchanging guest invite links.
# GUEST_ACCESS_SESSION_MINUTES=180

# Telnyx
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_PUBLIC_KEY=your-telnyx-public-key
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TEST_RECIPIENT=+1XXXXXXXXXX
TELNYX_PROFILE_ID=your-telnyx-profile-id
TELNYX_TEST_WEBHOOK_URL=https://webhook.site/your-webhook-id

# SMS Provider
SMS_PROVIDER=Twilio
SMS_THROTTLE_DELAY_MS=200

# Email Configuration (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_BILLING_EMAIL=billing@yourdomain.com
RESEND_FROM_NAME=YourPlatform
RESEND_TO_EMAIL=support@yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# Redis Configuration (shared cache, SSE, and production storefront inquiry limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_DB=0
REDIS_ENABLED=true
REDIS_MAX_CONNECTIONS=20
CACHE_ENABLED=true
CACHE_TTL=300

CI=false

# Stripe Configuration
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Couple Plan — One Wedding ($199 one-time; COUPLE_LIFETIME_OFFER in
# app/constants/billing.py). One wedding workspace, active through 90 days
# after the wedding — NOT lifetime access.
# - STRIPE_COUPLE_LIFETIME_PRICE_ID: backend price id that drives webhook
#   fulfillment (mode=payment). On checkout.session.completed with a line
#   item matching this price, the backend provisions the couple's wedding
#   workspace + portal account and sends the claim email
#   (app/services/couple_plan_fulfillment_service.py). Created via API
#   against the live "The Special Wedding — Couple Plan (One Wedding)"
#   product. Unset ⇒ one-time sessions are logged and ignored.
# - NEXT_PUBLIC_COUPLE_CHECKOUT_URL: Stripe Payment Link URL rendered as the
#   "For couples" CTA on the pricing page. This is inlined into the client
#   bundle at image build time (Dockerfile.frontend ARG + CI build-args from
#   the repo Actions variable NEXT_PUBLIC_COUPLE_CHECKOUT_URL — live link
#   created 2026-07-28 via Stripe API). Leave unset to fall back to the
#   sales/onboarding contact link instead of a fake checkout URL.
STRIPE_COUPLE_LIFETIME_PRICE_ID=price_your-couple-lifetime-price-id
NEXT_PUBLIC_COUPLE_CHECKOUT_URL=

# Slack Webhook
SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/url

# Twilio credentials for sending SMS notifications
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_ENABLED=true
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid

# Local development API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local Dev Frontend URL for email verification links and testing
FRONTEND_URL=http://localhost:3000

# Production public API URL (optional in split-service deployments; browser-side
# requests can derive this from the current frontend hostname at runtime)
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Server-only internal API URL for frontend SSR/data fetches and the runtime
# /api/proxy route.
# Single-container Coolify: use loopback so SSR and proxy traffic avoid public TLS.
# Split-service Coolify: point this at the backend reachable from the frontend
# container (Coolify private URL or the environment's public API domain).
# INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# Optional explicit backend target for the runtime /api/proxy route.
# Prefer this in split-service deployments when the backend has a stable
# Docker-network hostname. Not needed for single-container Dockerfile.coolify.
# BACKEND_SERVICE_URL=http://backend-prod:8000

# Production SSR revalidation for the public wedding bootstrap payload.
# WEDDING_PRIVACY_INFO_REVALIDATE_SECONDS=30

# Coolify backend worker count for the FastAPI process inside Dockerfile.coolify.
# Start with 2 on single-container deploys unless the host has ample CPU headroom.
# Multi-worker API mode requires REDIS_ENABLED=true for cross-worker SSE fan-out.
# WEB_CONCURRENCY=2

# Production Frontend URL
# FRONTEND_URL=https://yourdomain.com

# Staging split-service examples
# FRONTEND_URL=https://staging.yourdomain.com
# INTERNAL_API_BASE_URL=https://api.staging.yourdomain.com

# Google Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/planner/calendar/callback

# Aurinko calendar/tasks/contacts integration
AURINKO_API_BASE_URL=https://api.aurinko.io/v1
AURINKO_CLIENT_ID=your-aurinko-client-id
AURINKO_CLIENT_SECRET=your-aurinko-client-secret
AURINKO_REDIRECT_URI=http://localhost:3000/admin/planner/calendar/callback
AURINKO_WEBHOOK_SECRET=your-aurinko-webhook-signing-secret
AURINKO_OAUTH_STATE_SIGNING_KEY=your-aurinko-state-signing-key
AURINKO_SCOPES=Calendar.Read,Calendar.ReadWrite,Tasks.Read,Tasks.ReadWrite,Contacts.Read,Contacts.ReadWrite

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key

GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# Umami Analytics (self-hosted on Coolify)
# ============================================
# Deploy Umami in Coolify's one-click services (it bundles Postgres),
# set its public domain, then register your site inside Umami and copy
# the generated website UUID below.
#
# NEXT_PUBLIC_UMAMI_WEBSITE_ID  — the per-site UUID from Umami's UI.
# NEXT_PUBLIC_UMAMI_SRC         — fully qualified script URL on the
#                                  self-hosted instance.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-uuid
NEXT_PUBLIC_UMAMI_SRC=https://umami.yourdomain.com/script.js

# ============================================
# Umami Analytics — Backend (ROOT_ADMIN dashboard)
# ============================================
# Server-to-server connection used by /admin/analytics/funnel. NEVER prefix
# these with NEXT_PUBLIC_ — they must not leak into the client bundle.
#
# Auth model:
#   - Self-hosted Umami v3 has no API-key UI; the backend POSTs UMAMI_USERNAME
#     and UMAMI_PASSWORD to /api/auth/login, caches the returned JWT in Redis
#     for ~12h, and sends it as Authorization: Bearer <token>.
#   - If you're on Umami Cloud (or a future self-hosted build with API keys),
#     set UMAMI_API_KEY instead — it bypasses the login round-trip.
#
# Best practice: create a dedicated Umami user for the backend in Umami's
# Manage → Users panel rather than reusing the human admin login.
#
# UMAMI_API_BASE      — internal Umami URL (Docker overlay network preferred).
# UMAMI_USERNAME      — Umami login username for the backend's user.
# UMAMI_PASSWORD      — Umami login password for the backend's user.
# UMAMI_API_KEY       — Umami Cloud API key (optional; preempts login flow).
# UMAMI_WEBSITE_ID    — same UUID as NEXT_PUBLIC_UMAMI_WEBSITE_ID above.
# UMAMI_DASHBOARD_URL — public Umami URL for "Open in Umami" deep links.
UMAMI_API_BASE=http://umami-service:3000/api
UMAMI_USERNAME=wedding-backend
UMAMI_PASSWORD=your-strong-password-here
# UMAMI_API_KEY=
UMAMI_WEBSITE_ID=your-umami-website-uuid
UMAMI_DASHBOARD_URL=https://umami.yourdomain.com

# Ntfy Push Notifications
SERVICE_URL_NTFY=notify.yourdomain.com
NTFY_ADMIN_TOPIC=wedding-platform-admin

# ============================================
# STRIPE TEST CARDS (For Development/Testing)
# ============================================
# Use these card numbers with:
#   - Expiry: Any future date (e.g., 12/34)
#   - CVC: Any 3 digits (e.g., 123), 4 digits for Amex
#   - ZIP: Any 5 digits (e.g., 12345)
#   - Name: The test planner's name
#   - Email: The test planner's email

# --- SUCCESSFUL PAYMENT CARDS ---
STRIPE_TEST_CARD_VISA=4242424242424242
STRIPE_TEST_CARD_MASTERCARD=5555555555554444
STRIPE_TEST_CARD_AMEX=378282246310005
STRIPE_TEST_CARD_DISCOVER=6011111111111117

# --- DECLINED/FAILED PAYMENT CARDS ---
STRIPE_TEST_CARD_DECLINED=4000000000000002
STRIPE_TEST_CARD_INSUFFICIENT_FUNDS=4000000000009995
STRIPE_TEST_CARD_LOST=4000000000009987
STRIPE_TEST_CARD_STOLEN=4000000000009979
STRIPE_TEST_CARD_EXPIRED=4000000000000069
STRIPE_TEST_CARD_INCORRECT_CVC=4000000000000127
STRIPE_TEST_CARD_PROCESSING_ERROR=4000000000000119

# --- 3D SECURE / AUTHENTICATION CARDS ---
STRIPE_TEST_CARD_3DS_REQUIRED=4000002500003155
STRIPE_TEST_CARD_3DS_ALWAYS=4000002760003184
STRIPE_TEST_CARD_3DS_OPTIONAL=4000000000003220

# --- SPECIFIC ERROR TESTING ---
STRIPE_TEST_CARD_FRAUD_ALWAYS=4100000000000019
STRIPE_TEST_CARD_CHARGE_FAIL=4000000000000341

# --- DEFAULT TEST CREDENTIALS ---
STRIPE_TEST_EXPIRY=12/34
STRIPE_TEST_CVC=123
STRIPE_TEST_CVC_AMEX=1234
STRIPE_TEST_ZIP=12345
STRIPE_TEST_NAME=Test User

# Alert Email
ALERT_EMAIL=alerts@yourdomain.com

# Soketi (WebSocket server)
SOKETI_ENABLED=true
SOKETI_HOST=soketi.yourdomain.com
SOKETI_PORT=6001
SOKETI_APP_ID=your-app-id
SOKETI_KEY=your-app-key
SOKETI_SECRET=your-app-secret
SOKETI_USE_TLS=true

# Frontend Soketi (add to .env.local)
NEXT_PUBLIC_SOKETI_KEY=your-app-key
NEXT_PUBLIC_SOKETI_HOST=soketi.yourdomain.com
NEXT_PUBLIC_SOKETI_PORT=6001
NEXT_PUBLIC_SOKETI_USE_TLS=true

# VAPID Keys (Web Push Notifications)
VAPID_MAIL="mailto:admin@yourdomain.com"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# DigitalOcean
DIGITALOCEAN_ACCESS_TOKEN="your-digitalocean-access-token"
DOKS_CLUSTER_NAME="your-cluster-name"
