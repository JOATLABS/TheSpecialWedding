# =============================================================================
# BACKEND DOCKERFILE - FastAPI (separate container for K8s)
# Includes WeasyPrint dependencies for PDF generation
# =============================================================================
FROM python:3.11-slim-bookworm AS source-filter

WORKDIR /workspace

COPY ./app ./app
COPY ./scripts ./scripts

# The repo keeps Next.js and FastAPI code under the same top-level app tree.
# Build a Python-only source snapshot so the backend runtime image does not ship
# the frontend TS/TSX assets as dead weight.
RUN find app -type f ! -name '*.py' -delete && \
    find scripts -type f ! -name '*.py' -delete && \
    find /workspace -type d -name '__pycache__' -prune -exec rm -rf {} + && \
    find app -type d -empty -delete && \
    find scripts -type d -empty -delete

FROM python:3.11-slim-bookworm

WORKDIR /app

# Install system dependencies (WeasyPrint for PDF generation)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libffi-dev \
        libcairo2 \
        libcairo2-dev \
        libpangocairo-1.0-0 \
        libgdk-pixbuf2.0-0 \
        libffi8 \
        shared-mime-info \
        wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1

# Install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy filtered Python-only application code
COPY --from=source-filter /workspace/app ./app
COPY --from=source-filter /workspace/scripts ./scripts

# Create non-root user
RUN useradd -u 10001 -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Health check for K8s liveness
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8000/health/livez || exit 1

CMD ["sh", "-c", "python scripts/setup_admin_user.py --auto-create && python scripts/seed_subscription_plans.py && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4"]
