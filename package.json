{
  "name": "special-wedding-app",
  "version": "1.3.0",
  "description": "Wedding planning platform for professional wedding planners",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc -p tsconfig.tests.json --noEmit",
    "code-quality": "npm run lint:strict && npm run format:check && npm run type-check",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:auto": "auto-changelog -p --commit-limit false",
    "version": "npm run changelog && git add CHANGELOG.md",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix --force",
    "audit:report": "npm audit --json > security/audit-report.json",
    "audit:critical": "npm audit --audit-level=critical",
    "security": "npm run audit && npm run code-quality",
    "security:check": "npm audit --audit-level=moderate",
    "security:update": "npm update && npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update --save",
    "pre-deploy": "npm run security && npm run build",
    "reset-dev": "./scripts/reset-dev-server.sh",
    "clean": "bash ./scripts/clean-all.sh",
    "dev:fresh": "npm run clean && npm run dev",
    "rebuild:fresh": "npm run clean && npm ci && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@vercel/analytics": "^1.5.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.460.0",
    "next": "^15.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.4",
    "sonner": "^2.0.4",
    "tailwind-merge": "^2.2.1",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.29",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "auto-changelog": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "conventional-changelog-cli": "^5.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.5",
    "prettier": "^3.6.2",
    "puppeteer": "^24.16.2",
    "tailwindcss": "^3.4.0",
    "typescript": "5.8.3"
  }
}
