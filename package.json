{
  "name": "special-wedding-app",
  "version": "1.3.0",
  "description": "Wedding planning platform for professional wedding planners",
  "scripts": {
    "dev": "node scripts/ensure-deps.mjs && next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/**/*.test.ts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:auto": "auto-changelog -p --commit-limit false",
    "version": "npm run changelog && git add CHANGELOG.md",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix --force",
    "audit:report": "npm audit --json > security/audit-report.json",
    "audit:critical": "npm audit --audit-level=critical",
    "security": "npm run audit && npm run lint",
    "security:check": "npm audit --audit-level=moderate",
    "security:update": "npm update && npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update --save",
    "pre-deploy": "npm run security && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.7",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@swc/helpers": "^0.5.17",
    "@vercel/analytics": "^1.5.0",
    "d3-array": "^3.2.4",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12.23.26",
    "is-number": "^7.0.0",
    "lucide-react": "^0.546.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.56.4",
    "recharts": "^3.6.0",
    "sonner": "^2.0.4",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "tiny-invariant": "^1.3.3",
    "victory-vendor": "^37.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.15.29",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "auto-changelog": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.7",
    "conventional-changelog-cli": "^5.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "firebase": "^12.4.0",
    "firebase-tools": "^13.33.0",
    "postcss": "^8.5.5",
    "puppeteer": "^24.16.2",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.6",
    "typescript": "5.8.3"
  }
}
