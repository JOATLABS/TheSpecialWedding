{
  "name": "special-wedding-app",
  "version": "2.0.0",
  "license": "UNLICENSED",
  "description": "Wedding planning platform for professional wedding planners",
  "engines": {
    "node": ">=20.9 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/ensure-deps.mjs && next dev --webpack",
    "build": "node scripts/ensure-deps.mjs && npm run demo:validate-published-images && npm run demo:validate-published-videos && next build --webpack",
    "start": "next start",
    "lint": "node scripts/ensure-deps.mjs && npm run repo:check-copy-artifacts && eslint .",
    "type-check": "node scripts/ensure-deps.mjs && tsc --noEmit --pretty",
    "test": "node scripts/ensure-deps.mjs && tsx --test tests/**/*.test.ts tests/**/*.test.tsx",
    "test:e2e:storefront": ".venv.nosync/bin/python testbed/verify_storefront_frontend_lifecycle.py",
    "images:optimize": "npx -y -p node@16 -p @squoosh/cli squoosh-cli -d public --webp '{\"quality\":80}' --avif '{\"cqLevel\":33}' public/*.png",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:auto": "auto-changelog -p --commit-limit false",
    "version": "npm run changelog && git add CHANGELOG.md",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix --force",
    "audit:report": "npm audit --json > security/audit-report.json",
    "audit:critical": "npm audit --audit-level=critical",
    "security": "npm run audit && npm run lint",
    "security:check": "npm audit --audit-level=moderate",
    "security:update": "npm update && npm audit fix",
    "deps:doctor": "node scripts/ensure-deps.mjs --doctor",
    "deps:check": "npm outdated",
    "deps:update": "node scripts/update-deps.mjs --auto",
    "deps:update:dry": "node scripts/update-deps.mjs --dry-run",
    "deps:update:interactive": "node scripts/update-deps.mjs",
    "demo:requirements": "tsx scripts/demo-videos/validate-demo-video-production.ts",
    "demo:validate-images": "tsx scripts/demo-videos/validate-manual-product-images.ts --verify-git-ancestry",
    "demo:validate-published-images": "tsx scripts/demo-videos/validate-manual-product-images.ts --published",
    "demo:validate-published-videos": "tsx scripts/demo-videos/validate-demo-video-production.ts --published",
    "demo:validate-published-video-ancestry": "tsx scripts/demo-videos/validate-demo-video-production.ts --published --verify-git-ancestry",
    "demo:validate-published-ancestry": "tsx scripts/demo-videos/validate-manual-product-images.ts --published --verify-git-ancestry",
    "demo:validate-manual-video": "tsx scripts/demo-videos/validate-manual-demo-video.ts",
    "demo:validate-playback": "tsx scripts/demo-videos/validate-demo-video-playback-approval.ts",
    "demo:seed": "sh -c 'if [ -x .venv.nosync/bin/python ]; then PYTHON_BIN=.venv.nosync/bin/python; else PYTHON_BIN=python3; fi; TESTBED_NON_INTERACTIVE=1 exec \"$PYTHON_BIN\" testbed/verify_marketing_capture_workspace.py \"$@\"' --",
    "demo:auth-state": "tsx scripts/demo-videos/create-demo-storage-state.ts",
    "demo:music": "tsx scripts/demo-videos/generate-music-bed.ts",
    "demo:narrate": "tsx scripts/demo-videos/generate-narration.ts",
    "demo:approve-playback": "tsx scripts/demo-videos/refresh-playback-approval.ts",
    "demo:render": "tsx scripts/demo-videos/render-demo-video.ts",
    "demo:verify-routes": "tsx scripts/demo-videos/verify-demo-routes.ts",
    "demo:remotion:studio": "remotion studio remotion/index.ts",
    "repo:check-copy-artifacts": "node scripts/check-finder-copy-artifacts.mjs",
    "pre-deploy": "npm run security && npm run build"
  },
  "dependencies": {
    "@crazygl/hero-card-stack": "^0.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@headlessui/react": "^2.2.10",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@sentry/react": "^10.62.0",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.4",
    "tailwind-merge": "^3.4.0",
    "three": "^0.184.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@remotion/captions": "4.0.484",
    "@remotion/cli": "4.0.484",
    "@remotion/media": "4.0.484",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.184.0",
    "auto-changelog": "^2.6.0",
    "autoprefixer": "^10.5.2",
    "baseline-browser-mapping": "^2.10.27",
    "conventional-changelog-cli": "^4.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "puppeteer": "^25.2.1",
    "remotion": "4.0.484",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "5.8.3",
    "zod": "4.3.6"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
