{
  "name": "special-wedding-app",
  "version": "2.0.0",
  "license": "UNLICENSED",
  "description": "Wedding planning platform for professional wedding planners",
  "scripts": {
    "dev": "node scripts/ensure-deps.mjs && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/**/*.test.ts tests/**/*.test.tsx",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:auto": "auto-changelog -p --commit-limit false",
    "version": "npm run changelog && git add CHANGELOG.md",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix --force",
    "audit:report": "npm audit --json > security/audit-report.json",
    "audit:critical": "npm audit --audit-level=critical",
    "security": "npm run audit && npm run lint",
    "security:check": "npm audit --audit-level=moderate",
    "security:update": "npm update && npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "node scripts/update-deps.mjs --auto",
    "deps:update:dry": "node scripts/update-deps.mjs --dry-run",
    "deps:update:interactive": "node scripts/update-deps.mjs",
    "pre-deploy": "npm run security && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@headlessui/react": "^2.2.7",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/react": "^10.46.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@swc/helpers": "^0.5.17",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.546.0",
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.56.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.4",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.182.0",
    "auto-changelog": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.7",
    "conventional-changelog-cli": "^4.1.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.58.0",
    "postcss": "^8.5.5",
    "puppeteer": "^24.16.2",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.6",
    "typescript": "5.8.3"
  }
}
