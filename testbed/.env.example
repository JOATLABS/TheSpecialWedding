# testbed/.env — local overlay loaded after repo-root .env.
#
# Copy this file to `testbed/.env` and uncomment what you need. Values here
# override repo-root file defaults for the testbed CLI and every driver that
# instantiates Harness. Explicit shell exports on the current `testbed.py`
# invocation remain authoritative over both files, including intentionally
# blank values such as TESTBED_GOOGLE_MAPS_API_KEY="". Don't put production
# secrets here — this file is testbed-only tunables.

# ── testbed.py CLI ──────────────────────────────────────────────────────────

# Name of the tmux session that testbed.py drives. Change it if you want a
# second copy of the stack running side-by-side without clobbering the first.
# The reserved marketing-capture session defaults its frontend to port 3100 and
# always requires a real Next production server running under Node 22.
# TESTBED_SESSION_NAME=testbed

# Backend (FastAPI / uvicorn) port.
# TESTBED_BACKEND_PORT=8000

# Frontend (Next.js) port. Only used when --with-frontend / TESTBED_WITH_FRONTEND=1.
# TESTBED_FRONTEND_PORT=3000

# uvicorn module:app target and extra args. Defaults match the production entry.
# TESTBED_UVICORN_APP=app.main:app
# TESTBED_UVICORN_ARGS=--reload

# Stripe webhook path uvicorn mounts it at; must match app/main.py routing.
# TESTBED_STRIPE_WEBHOOK_PATH=/stripe/webhook

# Extra args appended verbatim to `stripe listen` (e.g. --events / --latest).
# TESTBED_STRIPE_LISTEN_EXTRA=

# Start the Next.js dev server alongside backend + stripe listen.
# TESTBED_WITH_FRONTEND=0

# Override the npm-only frontend start command.
# TESTBED_FRONTEND_CMD=npm run dev

# Canonical browser/backend media origin for the frontend window. Defaults to
# http://127.0.0.1:${TESTBED_FRONTEND_PORT}.
# TESTBED_FRONTEND_ORIGIN=http://127.0.0.1:3000

# Optional frontend-only environment overrides. Leave NODE_ENV unset for the
# normal development harness. The marketing-capture runbook explicitly uses
# production and an intentionally blank Maps key.
# TESTBED_FRONTEND_NODE_ENV=production
# TESTBED_GOOGLE_MAPS_API_KEY=

# Python interpreter used for seed scripts and the preflight import. Defaults
# to whatever interpreter invoked testbed.py — override if you keep the app in
# a dedicated venv that the CLI itself doesn't live in.
# TESTBED_PYTHON=/abs/path/to/venv/bin/python

# ── Harness behavior (testbed/harness.py) ───────────────────────────────────

# Skip every checkpoint() ENTER gate — use for CI-style unattended runs.
# TESTBED_NON_INTERACTIVE=1

# Seconds to wait for Stripe webhooks to settle after test-clock advances.
# TESTBED_WEBHOOK_SETTLE_SECONDS=10

# Default plan slug the driver subscribes the planner to if none is passed.
# TESTBED_DEFAULT_PLAN=planner_monthly

# Override backend / frontend loopback URLs when using non-default local ports.
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000

# Deterministic custom-domain provider harness. The storefront lifecycle driver
# starts this HTTPS FastAPI app itself with a run-scoped loopback certificate,
# isolated Mongo, and a production `next start`. It uses the real application
# routes/services with deterministic DNS/Cloudflare/HTTPS/email adapters. It is
# intentionally not evidence of an independently operated external provider.
# The run ID and control token are generated by the driver; do not set them.
# STOREFRONT_PROVIDER_HARNESS_CUSTOMER_ZONE=customer.test

# ── Planner storefront frontend lifecycle ──────────────────────────────────

# The verifier owns these dedicated loopback targets and refuses to reuse an
# occupied port. Do not point them at an ambient development or production
# service. Mongo must be a credential-free, single-host loopback URI.
# TESTBED_STOREFRONT_BACKEND_URL=https://127.0.0.1:8122
# TESTBED_STOREFRONT_FRONTEND_URL=https://127.0.0.1:3122
# TESTBED_STOREFRONT_FRONTEND_UPSTREAM_URL=http://127.0.0.1:3123
# TESTBED_STOREFRONT_MONGO_URI=mongodb://127.0.0.1:28127
# TESTBED_STOREFRONT_MONGO_DB=wedding_storefront_e2e
# TESTBED_STOREFRONT_NODE=/opt/homebrew/opt/node@22/bin/node

# Deterministic is the local/default provider mode. It proves the platform
# slug and the real FastAPI/Mongo custom-domain state machine without external
# provider claims. `live` remains fail-closed unless separately authorized.
# TESTBED_STOREFRONT_EXTERNAL_MODE=deterministic
# TESTBED_STOREFRONT_INQUIRY_DELIVERY_MODE=disabled
# STOREFRONT_RUNTIME_REVISION=<git-head>:<tracked-diff-sha256>
# The production configuration doctor requires a reachable shared Redis and an
# explicitly trusted ingress/header pair. The deterministic browser driver owns
# its isolated fallback and does not constitute production Redis evidence.
# REDIS_ENABLED=true
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=<test-only-redis-password>
# REDIS_DB=0
# REDIS_MAX_CONNECTIONS=20
# TRUSTED_PROXY_CIDRS=["127.0.0.1/32"]
# TRUSTED_PROXY_CLIENT_IP_HEADER=X-Real-IP
# STOREFRONT_CUSTOM_DOMAINS_ENABLED=false
# STOREFRONT_DOMAIN_CONNECT_DISCOVERY_ENABLED=false
# STOREFRONT_DOMAIN_CONNECT_AUTHORIZATION_ENABLED=false
# STOREFRONT_CLOUDFLARE_MUTATIONS_ENABLED=false
# STOREFRONT_CLOUDFLARE_CLEANUP_ENABLED=false
# STOREFRONT_CUSTOM_DOMAIN_ROLLOUT_MODE=allowlist
# STOREFRONT_CUSTOM_DOMAIN_PILOT_HOSTNAMES=[]
# STOREFRONT_CUSTOM_DOMAIN_PILOT_OWNER_IDS=[]
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_SAAS_API_TOKEN=
# Operator-only same-zone canary token; DNS Read + DNS Edit for the owned
# thespecialwedding.com zone only. It must differ from the SaaS token.
# CLOUDFLARE_PLATFORM_DNS_API_TOKEN=
# STOREFRONT_FALLBACK_ORIGIN=storefront-origin.thespecialwedding.com
# STOREFRONT_CNAME_TARGET=domains.thespecialwedding.com
# STOREFRONT_PLATFORM_DOMAINS=["thespecialwedding.io","thespecialwedding.com"]
# The isolated lifecycle driver generates a run-scoped value automatically.
# Manual split frontend/backend testbed runs must share one test-only value of
# at least 32 random bytes. Never reuse the production credential.
# STOREFRONT_PROBE_INGRESS_SECRET=
# DOMAIN_CONNECT_PROVIDER_ID=thespecialwedding.com
# DOMAIN_CONNECT_SERVICE_ID=storefront-subdomain
# DOMAIN_CONNECT_TEMPLATE_VERSION=1
# DOMAIN_CONNECT_PRIVATE_KEY=
# DOMAIN_CONNECT_KEY_ID=_dcpubkeyv1
# DOMAIN_CONNECT_PUBLIC_KEY_DOMAIN=domainconnect.thespecialwedding.com
# DOMAIN_CONNECT_CALLBACK_URL=https://domainconnect.thespecialwedding.com/admin/storefront/custom-domain/domain-connect/callback
# S3_STOREFRONT_STAGING_BUCKET_NAME=
# S3_REGION=auto
# BLOG_MEDIA_DOMAIN=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=The Special Wedding

# Live mode is only for an authorized disposable staging hostname and a small
# supported JPEG, PNG, or WebP. It remains BLOCKED without exact provider
# fencing and does not inherit deterministic-provider acceptance. The current
# live path validates configuration/allowlist fences only; it does not execute
# or pass an independently authoritative provider lifecycle.
# TESTBED_STOREFRONT_EXTERNAL_MODE=live
# TESTBED_STOREFRONT_INQUIRY_DELIVERY_MODE=required
# TESTBED_STOREFRONT_IMAGE_PATH=/absolute/path/to/storefront-test-image.jpg
# TESTBED_STOREFRONT_CUSTOM_DOMAIN=storefront-test.staging.example.com
# TESTBED_STOREFRONT_ALLOWED_CUSTOM_DOMAINS=["storefront-test.staging.example.com"]
# TESTBED_STOREFRONT_EXPECTED_PROVIDER_HOSTNAME_ID=<exact-disposable-cloudflare-hostname-id>
# TESTBED_STOREFRONT_ALLOWED_PROVIDER_HOSTNAME_IDS=<exact-disposable-cloudflare-hostname-id>
# TESTBED_STOREFRONT_ALLOWED_CNAME_TARGETS=domains.thespecialwedding.com
# TESTBED_STOREFRONT_ALLOWED_CLOUDFLARE_ACCOUNT_IDS=<exact-staging-account-id>
# TESTBED_STOREFRONT_ALLOWED_CLOUDFLARE_ZONE_IDS=<exact-staging-zone-id>
# TESTBED_STOREFRONT_ALLOWED_STAGING_BUCKETS=<exact-private-staging-bucket>
# TESTBED_STOREFRONT_ALLOWED_PUBLIC_BUCKETS=<exact-sanitized-public-bucket>
# CLOUDFLARE_API_TOKEN=
# S3_BLOG_BUCKET_NAME=

# Authorized same-zone infrastructure canary. This is deliberately separate
# from the browser lifecycle and can never satisfy independent-provider proof.
# TESTBED_STOREFRONT_SAME_ZONE_CANARY_RUN_ID=canary_20260715_unique
# TESTBED_STOREFRONT_SAME_ZONE_CANARY_AUTHORIZATION=canary_20260715_unique:canary-20260715.thespecialwedding.com:CREATE_AND_DELETE
# TESTBED_STOREFRONT_SAME_ZONE_CANARY_ARTIFACT=testbed/.testbed/artifacts/storefront/same-zone/canary_20260715_unique.json
# TESTBED_STOREFRONT_CANARY_TIMEOUT_SECONDS=1200
# TESTBED_STOREFRONT_CANARY_POLL_SECONDS=10

# Any future authorized live lifecycle must also use the application rollout
# gates. These values do not turn the current configuration-fence-only mode into
# external-provider evidence.
# STOREFRONT_CUSTOM_DOMAINS_ENABLED=true
# STOREFRONT_CLOUDFLARE_MUTATIONS_ENABLED=true
# STOREFRONT_CLOUDFLARE_CLEANUP_ENABLED=true
# STOREFRONT_CUSTOM_DOMAIN_ROLLOUT_MODE=allowlist
# STOREFRONT_CUSTOM_DOMAIN_PILOT_HOSTNAMES=["storefront-test.staging.example.com"]
# STOREFRONT_CUSTOM_DOMAIN_PILOT_OWNER_IDS=["<exact-test-planner-owner-id>"]

# JSON receipt and watched-browser artifacts. The default stays under ignored
# testbed runtime state.
# TESTBED_STOREFRONT_ARTIFACT_DIR=testbed/.testbed/artifacts/storefront

# This verifier and its cleanup always refuse remote backend, frontend, and
# Mongo targets. Provider-required mode still uses loopback app/database
# services plus only the exact disposable hostname allowlisted above.
