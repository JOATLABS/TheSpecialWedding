# ===============================================
# Backend-Only Docker Build Configuration
# Only include Python backend files, exclude Next.js frontend
# ===============================================

# === FRONTEND DIRECTORIES (Next.js) - EXCLUDE ===
app/admin/
app/components/
app/contexts/
app/hooks/
app/saas/
app/setup-account/
app/[slug]/
app/forms/
app/vendor-form/
app/verify-email/
app/styles/
app/types/

# === FRONTEND FILES - EXCLUDE ===
app/layout.tsx
app/page.tsx
app/*.tsx
app/*.jsx

# === NODE.JS / NPM - EXCLUDE ===
node_modules/
.next/
out/
build/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# === DEVELOPMENT FILES - EXCLUDE ===
.git/
.github/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === TESTING - EXCLUDE ===
tests/
test/
__tests__/
*.test.py
*.test.js
*.test.ts
coverage/
.coverage
htmlcov/
.pytest_cache/
playwright-report/
test-results/

# === DOCUMENTATION - EXCLUDE ===
*.md
!requirements.txt
docs/
app/docs/

# === DOCKER FILES - EXCLUDE ===
Dockerfile
docker-compose*.yml
.dockerignore

# === PYTHON CACHE - EXCLUDE ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# === ENVIRONMENT FILES - EXCLUDE ===
.env
.env.*
!.env.example

# === MISC - EXCLUDE ===
.gitignore
.gitattributes
.editorconfig
.eslintrc*
.prettierrc*
tsconfig.json
next.config.js
postcss.config.js
tailwind.config.ts

# === WHAT GETS INCLUDED ===
# ✅ app/main.py (FastAPI entry point)
# ✅ app/api/ (API routers)
# ✅ app/models/ (Database models)
# ✅ app/services/ (Business logic)
# ✅ app/core/ (Core config)
# ✅ app/middleware/ (Middleware)
# ✅ app/dependencies/ (DI)
# ✅ app/utils/ (Utilities)
# ✅ scripts/ (Database scripts)
# ✅ requirements.txt (Python deps)
