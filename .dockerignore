# =========================
# General Docker Ignore
# (Full-stack: keep source)
# =========================

# Git / editor
.git
.github
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node artifacts
node_modules
.next
out
dist
build
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python artifacts
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.eggs
.pytest_cache
htmlcov
.coverage

# Tests / docs (optional)
tests
test
__tests__
playwright-report
test-results
docs
*.md

# Env (do not bake secrets)
.env
.env.*
!.env.example
