# =============================================================================
# FULL-STACK DOCKER BUILD CONFIGURATION (COOLIFY)
# Includes both Python backend AND Next.js frontend
# Used for: thespecialwedding.io single-server deployment
# =============================================================================

# === DEVELOPMENT FILES - EXCLUDE ===
.git/
.github/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === TESTING - EXCLUDE ===
tests/
test/
__tests__/
*.test.py
*.test.js
*.test.ts
coverage/
.coverage
htmlcov/
.pytest_cache/
playwright-report/
test-results/

# === DOCUMENTATION - EXCLUDE ===
*.md
docs/
app/docs/

# === PYTHON CACHE - EXCLUDE ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg

# === NODE BUILD ARTIFACTS - EXCLUDE ===
# (will be built fresh in Docker)
.next/
out/
build/
dist/

# === ENVIRONMENT FILES - EXCLUDE ===
.env
.env.*
!.env.example

# === MISC - EXCLUDE ===
.gitignore
.gitattributes
.editorconfig
.eslintrc*
.prettierrc*
.dockerignore.backend
Dockerfile.coolify

# === WHAT GETS INCLUDED ===
# Frontend:
# ✅ app/admin/ (Next.js admin pages)
# ✅ app/components/ (React components)
# ✅ app/contexts/ (React contexts)
# ✅ app/hooks/ (React hooks)
# ✅ app/styles/ (CSS/styles)
# ✅ app/types/ (TypeScript types)
# ✅ public/ (Static assets)
# ✅ package.json, tsconfig.json, etc.

# Backend:
# ✅ app/main.py (FastAPI entry)
# ✅ app/api/ (API routers)
# ✅ app/models/ (Database models)
# ✅ app/services/ (Business logic)
# ✅ app/core/ (Core config)
# ✅ app/middleware/ (Middleware)
# ✅ app/dependencies/ (DI)
# ✅ app/utils/ (Utilities)
# ✅ scripts/ (Database scripts)
# ✅ requirements.txt (Python deps)
