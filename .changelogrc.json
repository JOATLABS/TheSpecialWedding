{
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "commitLimit": false,
    "unreleased": true,
    "sortCommits": "relevance",
    "excludeLabels": ["duplicate", "question", "invalid", "wontfix"],
    "includeBranch": ["main", "master", "development/saas-features"],
    "replaceText": {
      "fix: ": "Fixed: ",
      "feat: ": "Added: ",
      "docs: ": "Changed: ",
      "style: ": "Changed: ",
      "refactor: ": "Changed: ",
      "test: ": "Changed: ",
      "chore: ": "Changed: "
    }
  }
}