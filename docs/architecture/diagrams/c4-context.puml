@startuml C4_Context_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Wedding Web Application - System Context Diagram

Person(planner, "Wedding Planner", "Primary user managing multiple weddings")
Person(couple, "Couple", "Wedding owners with limited access")
Person(guest, "Wedding Guest", "Views wedding info and submits RSVP")
Person(vendor, "Vendor", "Service providers submitting quotes")

System(wedding_system, "Wedding Web Application", "Comprehensive SaaS platform for wedding planning and management")

System_Ext(email, "Email Service", "Resend API for transactional emails")
System_Ext(sms, "SMS Service", "Twilio/Telnyx for SMS notifications")
System_Ext(storage, "Cloud Storage", "Cloudflare R2 for file/image storage")
System_Ext(payment, "Payment Processing", "Stripe for subscription billing")
System_Ext(analytics, "Analytics", "Google Analytics for usage tracking")

Rel(planner, wedding_system, "Manages weddings, guests, budgets", "HTTPS")
Rel(couple, wedding_system, "Views and updates wedding details", "HTTPS")
Rel(guest, wedding_system, "Views wedding site, submits RSVP", "HTTPS")
Rel(vendor, wedding_system, "Submits quotes and information", "HTTPS")

Rel(wedding_system, email, "Sends transactional emails", "API/HTTPS")
Rel(wedding_system, sms, "Sends SMS notifications", "API/HTTPS")
Rel(wedding_system, storage, "Stores images and files", "S3 API")
Rel(wedding_system, payment, "Processes payments", "API/HTTPS")
Rel(wedding_system, analytics, "Tracks usage", "JavaScript")

@enduml
