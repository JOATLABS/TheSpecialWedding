---
title: Team Management — Technical Architecture & Data Flow
---
flowchart TB
    subgraph FRONTEND["Frontend (Next.js + Tailwind)"]
        direction TB
        FE1["AdminContext.tsx<br/>(Extended with team permissions)"]
        FE2["Sidebar.tsx<br/>(Permission-filtered nav)"]
        FE3["/admin/planner/team/page.tsx<br/>(Team Management Page)"]
        FE4["InviteTeamMemberModal.tsx<br/>(Role + Permissions + Wedding Scope)"]
        FE5["EditTeamMemberModal.tsx"]
        FE6["/admin/team/accept/page.tsx<br/>(Public Accept Page)"]
        FE7["All Dashboard Pages<br/>(Wedding-scoped for team members)"]
    end

    subgraph API["API Layer (FastAPI)"]
        direction TB
        API1["team_management.py<br/>12 endpoints under /admin/team"]
        API2["admin_auth.py<br/>(Login returns team context)"]
    end

    subgraph AUTH["Auth & Permission Layer"]
        direction TB
        AUTH1["auth_extended.py"]
        AUTH2["ExtendedAuthUser<br/>+ is_team_member<br/>+ parent_planner_id<br/>+ team_permissions<br/>+ team_wedding_access<br/>+ team_assigned_wedding_ids"]
        AUTH3["require_team_or_planner()"]
        AUTH4["require_team_permission(name)<br/>(Factory dependency)"]
        AUTH5["check_wedding_access()<br/>(Extended for team scoping)"]

        AUTH1 --> AUTH2
        AUTH2 --> AUTH3
        AUTH2 --> AUTH4
        AUTH2 --> AUTH5
    end

    subgraph GATES["Feature Gates"]
        direction TB
        GATE1["feature_gates.py"]
        GATE2["require_team_management<br/>Checks staff_seats > 0"]
        GATE3["check_feature_enabled<br/>(Existing pattern)"]
        GATE1 --> GATE2
        GATE1 --> GATE3
    end

    subgraph SERVICE["Service Layer"]
        direction TB
        SVC1["TeamManagementService"]
        SVC2["invite_team_member()"]
        SVC3["accept_invite()"]
        SVC4["update_team_member()"]
        SVC5["deactivate / reactivate()"]
        SVC6["check_seat_limit()"]
        SVC7["get_member_permissions()"]
        SVC1 --> SVC2 & SVC3 & SVC4 & SVC5 & SVC6 & SVC7
    end

    subgraph EMAIL["Email Service"]
        direction TB
        EM1["email_service_resend.py<br/>+ send_team_invite_email()"]
    end

    subgraph DB["MongoDB Collections"]
        direction TB
        DB1[("team_members<br/>───────────<br/>owner_id, email, role<br/>custom_permissions{}<br/>wedding_access<br/>assigned_wedding_ids[]<br/>invite_token<br/>status")]
        DB2[("users<br/>───────────<br/>+ role: team_member<br/>+ parent_planner_id<br/>+ team_member_id")]
        DB3[("subscription_plans<br/>───────────<br/>staff_seats: int<br/>features.team_management")]
        DB4[("user_subscriptions<br/>───────────<br/>usage.staff_seats_used")]
        DB5[("activity_logs<br/>───────────<br/>+ actor_role<br/>+ actor_team_member_id")]
    end

    subgraph EXISTING["Existing Endpoints (Modified)"]
        direction TB
        EX1["guest.py — manage_guests"]
        EX2["budget.py — manage_budget"]
        EX3["gallery_admin.py — manage_gallery"]
        EX4["tables.py — manage_seating"]
        EX5["vendor_management.py — manage_vendors"]
        EX6["reminder_twilio.py — send_reminders"]
        EX7["rspv.py — send_rsvp"]
        EX8["forms.py — manage_forms"]
        EX9["planner_metrics.py — view_analytics"]
        EX10["wedding.py — manage_wedding_settings"]
        EX11["contracts.py — manage_contracts"]
        EX12["packages.py — manage_packages"]
    end

    %% Connections
    FE1 -->|"apiRequest()"| API1
    FE1 -->|"apiRequest()"| API2
    FE3 --> FE4 & FE5
    FE6 -->|"Public endpoints"| API1

    API1 --> AUTH3
    API1 --> GATE2
    API1 --> SVC1

    SVC2 --> EM1
    SVC2 --> DB1
    SVC3 --> DB1 & DB2
    SVC6 --> DB3 & DB4

    AUTH3 --> AUTH2
    AUTH4 --> AUTH2
    AUTH2 -->|"Load team data"| DB1

    EXISTING --> AUTH3
    EXISTING --> AUTH4
    EXISTING --> AUTH5

    FE2 -->|"Filter by team_permissions"| FE1
    FE7 -->|"Filter by wedding_access"| FE1

    style FRONTEND fill:#1a1a2e,stroke:#D4A5A5,stroke-width:2px,color:#e2e8f0
    style API fill:#1a1a2e,stroke:#A8DADC,stroke-width:2px,color:#e2e8f0
    style AUTH fill:#1a1a2e,stroke:#a78bfa,stroke-width:2px,color:#e2e8f0
    style GATES fill:#1a1a2e,stroke:#E9C46A,stroke-width:2px,color:#e2e8f0
    style SERVICE fill:#1a1a2e,stroke:#4ade80,stroke-width:2px,color:#e2e8f0
    style EMAIL fill:#1a1a2e,stroke:#f472b6,stroke-width:2px,color:#e2e8f0
    style DB fill:#1a1a2e,stroke:#38bdf8,stroke-width:2px,color:#e2e8f0
    style EXISTING fill:#1a1a2e,stroke:#fb923c,stroke-width:2px,color:#e2e8f0
