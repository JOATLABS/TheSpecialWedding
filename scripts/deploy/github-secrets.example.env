# Copy this file to scripts/deploy/github-secrets.local.env and replace all
# placeholder values before running scripts/deploy/sync_github_secrets.sh.

# Optional convenience variable for the sync script. You can also pass
# --repo owner/repo on the command line instead.
GITHUB_REPOSITORY=your-github-owner/WeddingWebApp

# Shared Coolify access used by both staging deploys and production promotion.
COOLIFY_BASE_URL=https://app.coolify.io
COOLIFY_API_TOKEN=replace-me

# Coolify application UUIDs
COOLIFY_STAGING_FRONTEND_UUID=replace-me
COOLIFY_STAGING_BACKEND_UUID=replace-me
COOLIFY_PRODUCTION_FRONTEND_UUID=replace-me
COOLIFY_PRODUCTION_BACKEND_UUID=replace-me

# Staging smoke-test accounts
STAGING_SMOKE_ADMIN_EMAIL=staging-admin@example.com
STAGING_SMOKE_ADMIN_PASSWORD=replace-me
STAGING_SMOKE_COUPLE_EMAIL=staging-couple@example.com
STAGING_SMOKE_COUPLE_PASSWORD=replace-me
STAGING_SMOKE_PUBLIC_WEDDING_SLUG=your-staging-public-slug

# Production smoke-test accounts
PRODUCTION_SMOKE_ADMIN_EMAIL=production-admin@example.com
PRODUCTION_SMOKE_ADMIN_PASSWORD=replace-me
PRODUCTION_SMOKE_PUBLIC_WEDDING_SLUG=your-production-public-slug
