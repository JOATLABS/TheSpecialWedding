{
  "info": {
    "name": "Wedding Web App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API endpoints for managing a wedding web application"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login for Admin Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"emmanuel.t.akinwale@gmail.com\",\n    \"password\": \"j89x8G&8SM8^m\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/admin/token",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["admin", "token"]
            },
            "description": "Authenticate as admin and receive a JWT token"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All RSVPs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/admin/rsvps",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["admin", "rsvps"]
            },
            "description": "Retrieve all RSVPs (requires admin authentication)"
          }
        },
        {
          "name": "Export RSVPs to CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/admin/rsvps/export",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["admin", "rsvps", "export"]
            },
            "description": "Export all RSVPs to CSV format (requires admin authentication)"
          }
        },
        {
          "name": "Import Guests from CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/admin/guests/import?wedding_id=wedding1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["admin", "guests", "import"],
              "query": [
                {
                  "key": "wedding_id",
                  "value": "wedding1"
                }
              ]
            },
            "description": "Import guests from a CSV file (requires admin authentication)"
          }
        }
      ]
    },
    {
      "name": "Guest",
      "item": [
        {
          "name": "Get Guest by Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/guest/invite/{{guest_token}}?wedding_id=wedding1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["guest", "invite", "{{guest_token}}"],
              "query": [
                {
                  "key": "wedding_id",
                  "value": "wedding1"
                }
              ]
            },
            "description": "Retrieve guest information using their invitation token"
          }
        },
        {
          "name": "Search for Guest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/guest/invite/search?name={{guest_name}}&phone={{guest_phone}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["guest", "invite", "search"],
              "query": [
                {
                  "key": "name",
                  "value": "{{guest_name}}"
                },
                {
                  "key": "phone",
                  "value": "{{guest_phone}}"
                }
              ]
            },
            "description": "Search for a guest by name and/or phone number"
          }
        }
      ]
    },
    {
      "name": "RSVP",
      "item": [
        {
          "name": "Submit RSVP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"attending\": [\"traditional\", \"reception\"],\n    \"dietary\": \"Vegetarian\",\n    \"phone\": \"+1234567890\",\n    \"plus_one\": {\n        \"name\": \"Guest Name\",\n        \"attending\": [\"traditional\", \"reception\"],\n        \"dietary\": \"No allergies\"\n    }\n}"
            },
            "url": {
              "raw": "http://localhost:8000/rsvp/invite/{{guest_token}}/rsvp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["rsvp", "invite", "{{guest_token}}", "rsvp"]
            },
            "description": "Submit an RSVP for a guest"
          }
        }
      ]
    },
    {
      "name": "Plus-One",
      "item": [
        {
          "name": "Add Plus One",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"guest_id\": \"{{guest_id}}\",\n    \"name\": \"Guest Name\",\n    \"attending\": [\"traditional\", \"reception\"],\n    \"dietary\": \"No allergies\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/plus_one/plus-ones",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["plus_one", "plus-ones"]
            },
            "description": "Add a plus one for a guest"
          }
        },
        {
          "name": "Get Plus Ones for Guest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/plus_one/plus-ones/{{guest_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["plus_one", "plus-ones", "{{guest_id}}"]
            },
            "description": "Get all plus ones for a specific guest"
          }
        },
        {
          "name": "Update Plus One",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Updated Name\",\n    \"attending\": [\"reception\"],\n    \"dietary\": \"Updated dietary requirements\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/plus_one/plus-ones/{{plus_one_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["plus_one", "plus-ones", "{{plus_one_id}}"]
            },
            "description": "Update an existing plus one"
          }
        },
        {
          "name": "Delete Plus One",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/plus_one/plus-ones/{{plus_one_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["plus_one", "plus-ones", "{{plus_one_id}}"]
            },
            "description": "Delete a plus one"
          }
        }
      ]
    },
    {
